<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Homework Platform</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container" style="padding-top: 60px; text-align: center;">
    <h1 style="font-size: 2rem; margin-bottom: 8px;">Homework Platform</h1>
    <p style="color:#718096; margin-bottom: 10px;">Submit and check homework easily</p>

    <div class="home-choice">
      <a href="/student" class="home-card">
        <div style="font-size: 2.5rem;">👨‍🎓</div>
        <h2>Student</h2>
        <p>Choose your group and submit homework</p>
      </a>

      <a href="/teacher/login" class="home-card">
        <div style="font-size: 2.5rem;">👩‍🏫</div>
        <h2>Teacher</h2>
        <p>Manage groups, assignments and check work</p>
      </a>
    </div>
  </div>
</body>
</html>
