<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= group.name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="nav">
    <strong><%= group.name %></strong>
    <div>
      <a href="/teacher/groups">← Groups</a>
      <a href="/teacher">Dashboard</a>
      <a href="/teacher/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <h1><%= group.name %></h1>
    <p class="meta"><%= group.students.length %> students</p>

    <div class="card">
      <h2>Add students</h2>
      <p class="meta">Paste one full name per line</p>
      <form method="POST" action="/teacher/groups/<%= group.id %>/students">
        <div class="form-group">
          <textarea name="students" placeholder="Aliyev Jasur&#10;Karimova Nilufar&#10;..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Add Students</button>
      </form>
    </div>

    <div class="card">
      <h2>Student list</h2>
      <% if (group.students.length === 0) { %>
        <p class="meta">No students yet.</p>
      <% } else { %>
        <table class="table">
          <thead>
            <tr><th>#</th><th>Full Name</th><th></th></tr>
          </thead>
          <tbody>
            <% group.students.forEach((name, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= name %></td>
                <td>
                  <form method="POST" action="/teacher/groups/<%= group.id %>/students/remove" style="display:inline;">
                    <input type="hidden" name="name" value="<%= name %>">
                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
