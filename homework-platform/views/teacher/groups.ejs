<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Groups</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="nav">
    <strong>Groups</strong>
    <div>
      <a href="/teacher">Dashboard</a>
      <a href="/teacher/assignments">Assignments</a>
      <a href="/teacher/settings">Settings</a>
      <a href="/teacher/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <h1>Groups</h1>

    <div class="card">
      <h2>Add new group</h2>
      <form method="POST" action="/teacher/groups/add" style="display:flex; gap:10px; flex-wrap:wrap;">
        <input type="text" name="name" placeholder="e.g. K.XTA-BU-23" required style="flex:1; min-width:200px;">
        <button type="submit" class="btn btn-primary">Add Group</button>
      </form>
    </div>

    <div class="card">
      <h2>Your groups (<%= groups.length %>)</h2>
      <% if (groups.length === 0) { %>
        <p class="meta">No groups yet. Create one above.</p>
      <% } else { %>
        <table class="table">
          <thead>
            <tr>
              <th>Group name</th>
              <th>Students</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(g => { %>
              <tr>
                <td><strong><%= g.name %></strong></td>
                <td><%= g.students.length %> students</td>
                <td>
                  <a href="/teacher/groups/<%= g.id %>" class="btn btn-sm btn-secondary">Manage</a>
                  <form method="POST" action="/teacher/groups/<%= g.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this group and all its data?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
