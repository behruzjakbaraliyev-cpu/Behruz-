<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>New Assignment</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="nav">
    <strong>New Assignment</strong>
    <div>
      <a href="/teacher/assignments">← Back</a>
      <a href="/teacher/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <h1>Create Assignment</h1>
      <form method="POST" action="/teacher/assignments/new" enctype="multipart/form-data">
        <div class="form-group">
          <label>Group *</label>
          <select name="groupId" required>
            <option value="">— Select group —</option>
            <% groups.forEach(g => { %>
              <option value="<%= g.id %>"><%= g.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Title *</label>
          <input type="text" name="title" required placeholder="e.g. Metaphor homework">
        </div>
        <div class="form-group">
          <label>Description (optional)</label>
          <textarea name="description" placeholder="Instructions for students..."></textarea>
        </div>
        <div class="form-group">
          <label>Deadline *</label>
          <input type="datetime-local" name="deadline" required>
        </div>
        <div class="form-group">
          <label>Attach files for students (optional)</label>
          <input type="file" name="files" multiple accept=".pdf,.doc,.docx,.jpg,.png,.txt">
          <p class="meta">Students can download these files as the homework materials.</p>
        </div>
        <button type="submit" class="btn btn-primary">Create Assignment</button>
      </form>
    </div>
  </div>
</body>
</html>
